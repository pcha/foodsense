rules_version = '2';

// Todo lo que cuelga de users/{userId} es privado de ese usuario. Los match son explícitos por
// colección a propósito: las reglas son aditivas, así que un wildcard recursivo no se puede
// angostar después sin reescribirlo. Cada colección nueva son tres líneas.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // FirebaseFirestoreSyncRepository: upsertProduct / deleteProduct / updateProductItems
      // sobre el doc, y fetchAll / listenToChanges como query sobre la colección.
      match /products/{productId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
